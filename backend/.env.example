# Database
DATABASE_URL=postgresql://crm_user:crm_password@postgres:5432/agentic_crm

# Redis
REDIS_URL=redis://redis:6379

# APIs
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here
LINKEDIN_API_KEY=
CRUNCHBASE_API_KEY=

# Security
JWT_SECRET_KEY=your_secret_key_min_32_chars_here_change_this_now
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Server
PORT=8000
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Gemini Quota
DAILY_GEMINI_TOKENS=1000000

# Password Hashing Rounds
BCRYPT_ROUNDS=12
