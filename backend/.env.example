# Database
ACTIVE_DB_PROVIDER=local
LOCAL_DATABASE_URL=postgresql://crm_user:crm_password@postgres:5432/agentic_crm
SUPABASE_DATABASE_URL=
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379

# APIs
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_token_here
BRAVE_SEARCH_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LINKEDIN_API_KEY=
CRUNCHBASE_API_KEY=

# Security
JWT_SECRET_KEY=your_secret_key_min_32_chars_here_change_this_now
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Server
PORT=8000
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
DEBUG_TRACE_ENABLED=true

# Crawling
CRAWL_PROVIDER=crawl4ai
CRAWL_BROWSER_TYPE=chromium
CRAWL_HEADLESS=true
CRAWL_TEXT_MODE=true
CRAWL_LIGHT_MODE=false
CRAWL_HTTP_FALLBACK_ENABLED=true
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_VERBOSE=false
CRAWL_USER_AGENT=AgenticCRMResearchBot/1.0
CRAWL_WORD_COUNT_THRESHOLD=10
CRAWL_WAIT_FOR=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Gemini Quota
DAILY_GEMINI_TOKENS=1000000

# Password Hashing Rounds
BCRYPT_ROUNDS=12
